            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/SensorMetric"
            }
          },
          "aiVisionLogs": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/AiVisionLog"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SensorMetric": {
        "required": [
