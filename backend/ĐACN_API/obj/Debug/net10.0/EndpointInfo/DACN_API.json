              "number",
              "string"
            ],
            "format": "float"
          },
          "nh3Level": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
